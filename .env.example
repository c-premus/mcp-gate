# mcp-gate configuration
# Copy to .env and fill in values for your environment.

# Required
LISTEN_ADDR=0.0.0.0:8080
UPSTREAM_URL=http://mcp-server:8000
RESOURCE_URI=https://mcp.example.com
AUTHORIZATION_SERVER=https://auth.example.com/application/o/mcp/
JWKS_URI=https://auth.example.com/application/o/mcp/jwks/
EXPECTED_ISSUER=https://auth.example.com/application/o/mcp/
EXPECTED_AUDIENCE=your-oauth-client-id

# Optional
# REQUIRED_SCOPES=openid
# SCOPES_SUPPORTED=openid,profile
# RESOURCE_NAME=MCP Server
# RESOURCE_DOCUMENTATION=https://github.com/your-org/your-mcp-server
# AUTH_REALM defaults to the RESOURCE_URI hostname; set it only to override.
# AUTH_REALM=mcp.example.com
# LOG_LEVEL=info
# TRUSTED_PROXIES=172.20.0.0/16

# Origin validation (MCP 2026-07-28 DNS-rebinding requirement). Leave unset
# unless mcp-gate fronts a LAN- or loopback-adjacent MCP server: a public HTTPS
# origin cannot be DNS-rebound, and a wrong allow-list 403s every request while
# /healthz stays green, so nothing rolls the deploy back. Exact matches only —
# no wildcards. A request with no Origin header is always allowed.
# ALLOWED_ORIGINS=https://claude.ai,https://claude.com
# JWKS_REFRESH_INTERVAL=1h
# SHUTDOWN_TIMEOUT=30s
# METRICS_ADDR=:9090

# Observability
# OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
# OTEL_SERVICE_NAME=mcp-gate
# OTEL_TRACE_SAMPLE_RATE=1.0

# Timeouts & Limits
# UPSTREAM_TIMEOUT=120s
# READ_TIMEOUT=30s
# IDLE_TIMEOUT=120s
# MAX_HEADER_BYTES=131072
# MAX_REQUEST_BODY=10485760
# RATE_LIMIT_RPS=10
# RATE_LIMIT_BURST=20
# MAX_CONCURRENT_REQUESTS=100
# MAX_TOTAL_CONNECTIONS=1000
# SSE_IDLE_TIMEOUT=5m

# Rate limiter backend. UNSET (the default) = in-process token bucket, which is
# per-replica: N replicas allow N x RATE_LIMIT_RPS per client. Set REDIS_ADDR to
# coordinate globally via GCRA instead. Fail-open by design — a Redis outage
# forwards the request and increments mcpgate_ratelimit_redis_errors_total
# rather than taking the proxy down.
#
# Note the variable is REDIS_ADDR (host:port), NOT REDIS_URL. Config is a field
# per value so Vault can inject REDIS_PASSWORD verbatim: passwords containing
# : @ / # or ? are all valid in Redis ACLs and all reserved in URL syntax, and
# rotation tooling that does not percent-encode breaks auth silently.
# REDIS_ADDR=redis:6379
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_TIMEOUT=100ms
# REDIS_KEY_PREFIX=mcpgate:rl:
