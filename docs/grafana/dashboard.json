{
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 0,
  "fiscalYearStartMonth": 0,
  "schemaVersion": 41,
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "DS_PROMETHEUS",
        "skipUrlSync": false,
        "multi": false,
        "allowCustomValue": true,
        "includeAll": false,
        "auto": false,
        "auto_min": "10s",
        "auto_count": 30,
        "label": "Prometheus",
        "query": "prometheus"
      },
      {
        "type": "datasource",
        "name": "DS_TEMPO",
        "skipUrlSync": false,
        "multi": false,
        "allowCustomValue": true,
        "includeAll": false,
        "auto": false,
        "auto_min": "10s",
        "auto_count": 30,
        "label": "Tempo",
        "query": "tempo"
      },
      {
        "type": "datasource",
        "name": "DS_LOKI",
        "skipUrlSync": false,
        "multi": false,
        "allowCustomValue": true,
        "includeAll": false,
        "auto": false,
        "auto_min": "10s",
        "auto_count": 30,
        "label": "Loki",
        "query": "loki"
      }
    ]
  },
  "annotations": {},
  "title": "mcp-gate",
  "uid": "mcp-gate",
  "description": "OAuth 2.1 reverse proxy for MCP servers — RED metrics, authentication, upstream proxy, traces, and logs.",
  "tags": [
    "mcp-gate",
    "mcp",
    "oauth"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "type": "row",
      "collapsed": true,
      "id": 0,
      "panels": [
        {
          "type": "stat",
          "transparent": false,
          "repeatDirection": "h",
          "title": "Request Rate",
          "description": "Requests per second",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "reqps"
            },
            "overrides": []
          },
          "gridPos": {
            "h": 4,
            "w": 4,
            "x": 0,
            "y": 1
          },
          "targets": [
            {
              "expr": "sum(rate(mcpgate_http_requests_total{job=\"mcp-gate\"}[$__rate_interval]))",
              "refId": "A",
              "legendFormat": "req/s"
            }
          ]
        },
        {
          "type": "stat",
          "transparent": false,
          "repeatDirection": "h",
          "title": "Error Rate",
          "description": "5xx responses as percentage of total",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "percentunit",
              "decimals": 2
            },
            "overrides": []
          },
          "gridPos": {
            "h": 4,
            "w": 4,
            "x": 4,
            "y": 1
          },
          "targets": [
            {
              "expr": "sum(rate(mcpgate_http_requests_total{job=\"mcp-gate\",status_code=~\"5..\"}[$__rate_interval])) / sum(rate(mcpgate_http_requests_total{job=\"mcp-gate\"}[$__rate_interval]))",
              "refId": "A",
              "legendFormat": "error %"
            }
          ]
        },
        {
          "type": "stat",
          "transparent": false,
          "repeatDirection": "h",
          "title": "P95 Latency",
          "description": "95th percentile request latency",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "s",
              "decimals": 3
            },
            "overrides": []
          },
          "gridPos": {
            "h": 4,
            "w": 4,
            "x": 8,
            "y": 1
          },
          "targets": [
            {
              "expr": "histogram_quantile(0.95, sum(rate(mcpgate_http_request_duration_seconds_bucket{job=\"mcp-gate\"}[$__rate_interval])) by (le))",
              "refId": "A",
              "legendFormat": "p95"
            }
          ]
        },
        {
          "type": "timeseries",
          "transparent": false,
          "repeatDirection": "h",
          "title": "Request Rate by Status",
          "description": "HTTP request rate broken down by status code",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "reqps"
            },
            "overrides": []
          },
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 1
          },
          "targets": [
            {
              "expr": "sum by (status_code) (rate(mcpgate_http_requests_total{job=\"mcp-gate\"}[$__rate_interval]))",
              "refId": "A",
              "legendFormat": "{{status_code}}"
            }
          ]
        },
        {
          "type": "timeseries",
          "transparent": false,
          "repeatDirection": "h",
          "title": "Request Latency Percentiles",
          "description": "P50, P90, P99 request latency",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "s"
            },
            "overrides": []
          },
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 9
          },
          "targets": [
            {
              "expr": "histogram_quantile(0.50, sum(rate(mcpgate_http_request_duration_seconds_bucket{job=\"mcp-gate\"}[$__rate_interval])) by (le))",
              "refId": "A",
              "legendFormat": "p50"
            },
            {
              "expr": "histogram_quantile(0.90, sum(rate(mcpgate_http_request_duration_seconds_bucket{job=\"mcp-gate\"}[$__rate_interval])) by (le))",
              "refId": "B",
              "legendFormat": "p90"
            },
            {
              "expr": "histogram_quantile(0.99, sum(rate(mcpgate_http_request_duration_seconds_bucket{job=\"mcp-gate\"}[$__rate_interval])) by (le))",
              "refId": "C",
              "legendFormat": "p99"
            }
          ]
        }
      ],
      "title": "Service Overview",
      "gridPos": {
        "x": 0,
        "y": 0,
        "h": 1,
        "w": 24
      }
    },
    {
      "type": "row",
      "collapsed": true,
      "id": 0,
      "panels": [
        {
          "type": "stat",
          "transparent": false,
          "repeatDirection": "h",
          "title": "Valid Auth",
          "description": "Successful JWT validations per second",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "reqps"
            },
            "overrides": []
          },
          "gridPos": {
            "h": 4,
            "w": 3,
            "x": 0,
            "y": 18
          },
          "targets": [
            {
              "expr": "sum(rate(mcpgate_auth_validations_total{job=\"mcp-gate\",outcome=\"valid\"}[$__rate_interval]))",
              "refId": "A",
              "legendFormat": "valid/s"
            }
          ]
        },
        {
          "type": "stat",
          "transparent": false,
          "repeatDirection": "h",
          "title": "No Token",
          "description": "Requests without Bearer token per second",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "reqps"
            },
            "overrides": []
          },
          "gridPos": {
            "h": 4,
            "w": 3,
            "x": 3,
            "y": 18
          },
          "targets": [
            {
              "expr": "sum(rate(mcpgate_auth_validations_total{job=\"mcp-gate\",outcome=\"no_token\"}[$__rate_interval]))",
              "refId": "A",
              "legendFormat": "no_token/s"
            }
          ]
        },
        {
          "type": "stat",
          "transparent": false,
          "repeatDirection": "h",
          "title": "Invalid Token",
          "description": "Invalid/expired token rejections per second",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "reqps"
            },
            "overrides": []
          },
          "gridPos": {
            "h": 4,
            "w": 3,
            "x": 6,
            "y": 18
          },
          "targets": [
            {
              "expr": "sum(rate(mcpgate_auth_validations_total{job=\"mcp-gate\",outcome=\"invalid_token\"}[$__rate_interval]))",
              "refId": "A",
              "legendFormat": "invalid/s"
            }
          ]
        },
        {
          "type": "stat",
          "transparent": false,
          "repeatDirection": "h",
          "title": "Insufficient Scope",
          "description": "Scope-check failures per second",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "reqps"
            },
            "overrides": []
          },
          "gridPos": {
            "h": 4,
            "w": 3,
            "x": 9,
            "y": 18
          },
          "targets": [
            {
              "expr": "sum(rate(mcpgate_auth_validations_total{job=\"mcp-gate\",outcome=\"insufficient_scope\"}[$__rate_interval]))",
              "refId": "A",
              "legendFormat": "scope_fail/s"
            }
          ]
        },
        {
          "type": "timeseries",
          "transparent": false,
          "repeatDirection": "h",
          "title": "Auth Failure Rate",
          "description": "Authentication failures over time by outcome",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "reqps"
            },
            "overrides": []
          },
          "gridPos": {
            "h": 8,
            "w": 6,
            "x": 12,
            "y": 18
          },
          "targets": [
            {
              "expr": "sum by (outcome) (rate(mcpgate_auth_validations_total{job=\"mcp-gate\",outcome!=\"valid\"}[$__rate_interval]))",
              "refId": "A",
              "legendFormat": "{{outcome}}"
            }
          ]
        },
        {
          "type": "piechart",
          "transparent": false,
          "repeatDirection": "h",
          "title": "Auth Outcomes",
          "description": "Distribution of authentication outcomes",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "gridPos": {
            "h": 8,
            "w": 6,
            "x": 18,
            "y": 18
          },
          "targets": [
            {
              "expr": "sum by (outcome) (increase(mcpgate_auth_validations_total{job=\"mcp-gate\"}[$__range]))",
              "refId": "A",
              "legendFormat": "{{outcome}}",
              "instant": true,
              "range": false
            }
          ]
        }
      ],
      "title": "Authentication",
      "gridPos": {
        "x": 0,
        "y": 17,
        "h": 1,
        "w": 24
      }
    },
    {
      "type": "row",
      "collapsed": true,
      "id": 0,
      "panels": [
