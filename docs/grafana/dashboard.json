              "expr": "sum(rate(mcpgate_proxy_requests_total{job=\"mcp-gate\",status_code=~\"5..\"}[$__rate_interval])) / sum(rate(mcpgate_proxy_requests_total{job=\"mcp-gate\"}[$__rate_interval]))",
